# Optional, advanced only. The factory image needs NO secrets file:
# flash via web flasher, provision Wi-Fi via Improv/USB or the
# HeatWhisper fallback AP (password heatwhisper01), adopt in HA.
# Copy this file to secrets.yaml only if you compile locally with extras
# (MQTT, or hardening after adoption: api encryption / ota / web auth).
# Advanced MQTT example (uncomment mqtt: block at bottom of packages/base.yaml):
# mqtt_broker: "YOUR_MQTT_BROKER"
# mqtt_user: "YOUR_MQTT_USER"
# mqtt_password: "YOUR_MQTT_PASSWORD"
